# NAMROS production-shaped Kubernetes/kind deployment defaults.
#
# This file is sourced by scripts/k8s/deploy-production.sh. Keep values as
# KEY=VALUE shell assignments.

NAMROS_K8S_RELEASE=namros
NAMROS_K8S_NAMESPACE=namros
NAMROS_K8S_CHART=packaging/helm/namros-community
NAMROS_K8S_KIND_CLUSTER=namros-production
NAMROS_K8S_KIND_CONFIG=packaging/k8s/kind-production.yaml

# Default topology requested for the public production-shaped scenario.
NAMROS_K8S_GATEWAY_REPLICAS=2
NAMROS_K8S_SBS_SERVICE_REPLICAS=2
NAMROS_K8S_SBS_DATA_REPLICAS=5
NAMROS_K8S_TIKV_REPLICAS=1
NAMROS_K8S_PD_REPLICAS=1
NAMROS_K8S_ETCD_REPLICAS=1

# kind publishes the gateway through the node port mapped in kind-production.yaml.
NAMROS_K8S_GATEWAY_SERVICE_TYPE=NodePort
NAMROS_K8S_GATEWAY_SERVICE_PORT=9000
NAMROS_K8S_GATEWAY_NODE_PORT=30900

NAMROS_K8S_DEPLOYMENT_PROFILE=production
NAMROS_K8S_REGION=us-east-1
NAMROS_K8S_METADATA_BACKEND=tikv
NAMROS_K8S_COORDINATION_BACKEND=etcd

# Embedded dependencies are for kind and evaluation only. For a real production
# cluster, set these to false and provide external TiKV/etcd endpoints.
NAMROS_K8S_EMBEDDED_TIKV=true
NAMROS_K8S_EMBEDDED_ETCD=true
NAMROS_K8S_EXTERNAL_TIKV_PD_ENDPOINTS=
NAMROS_K8S_EXTERNAL_ETCD_ENDPOINTS=

NAMROS_K8S_ROOT_CREDENTIALS_CREATE=true
NAMROS_K8S_ROOT_CREDENTIALS_SECRET=
NAMROS_K8S_ROOT_ACCESS_KEY_ID=namrosroot
NAMROS_K8S_ROOT_SECRET_ACCESS_KEY=namrosrootsecret

NAMROS_K8S_IMAGE_TAG=local
NAMROS_K8S_SBS_IMAGE_TAG=local
NAMROS_K8S_GATEWAY_IMAGE=namros-gateway
NAMROS_K8S_TOOLS_IMAGE=namros-tools
NAMROS_K8S_SBS_SERVICE_IMAGE=namros-sbs-service
NAMROS_K8S_SBS_DATA_IMAGE=namros-sbs-data
NAMROS_K8S_SBSCTL_IMAGE=namros-sbsctl
NAMROS_K8S_IMAGE_PULL_POLICY=IfNotPresent

NAMROS_K8S_SBS_CLUSTER_ID=namros-production-sbs
NAMROS_K8S_CLUSTER_ID=namros-production
NAMROS_K8S_SBS_VOLUME_POOL_ID=production-pool
NAMROS_K8S_SBS_VOLUME_POOL_GENERATION=0
NAMROS_K8S_SBS_VOLUME_ID_PREFIX=18d0000
NAMROS_K8S_SBS_VOLUME_SIZE=64M
NAMROS_K8S_SBS_BLOCK_SIZE=4K
NAMROS_K8S_SBS_ALLOCATION_CHUNK_SIZE=1M
NAMROS_K8S_SBS_ALLOCATION_PAGE_SIZE=4M
NAMROS_K8S_SBS_REPLICATION_FACTOR=3
NAMROS_K8S_SBS_CHUNK_SIZE_BYTES=1048576
NAMROS_K8S_SBS_ATTACHMENT_ID=att-namros-production-kind-object-pool
NAMROS_K8S_SBS_WRITER_GROUP_ID=namros-production-kind-writers
NAMROS_K8S_SBS_VOLUME_EPOCH=1
NAMROS_K8S_SBS_ZONES=zone-a,zone-b,zone-c,zone-a,zone-b

# kind-production-deploy builds and loads local images by default.
NAMROS_K8S_KIND_BUILD_IMAGES=true
