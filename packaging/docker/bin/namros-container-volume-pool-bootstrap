#!/usr/bin/env sh
set -eu

log() {
	printf '[volume-pool-bootstrap] %s\n' "$*" >&2
}

metadata_backend="${NAMROS_METADATA_BACKEND:-tikv}"
tikv_pd_endpoints="${NAMROS_TIKV_PD_ENDPOINTS:-pd:2379}"
pool_id="${NAMROS_COMMUNITY_SBS_VOLUME_POOL_ID:-object-pool}"
generation="${NAMROS_COMMUNITY_SBS_VOLUME_POOL_GENERATION:-0}"
service_endpoint="${NAMROS_COMMUNITY_SBS_SERVICE_ENDPOINT:-sbs-service-lb:9443}"
data_endpoint="${NAMROS_COMMUNITY_SBS_DATA_ENDPOINT:-sbs-data-1:9444}"
data_endpoints="${NAMROS_COMMUNITY_SBS_DATA_ENDPOINTS:-$data_endpoint}"
chunk_size_bytes="${NAMROS_COMMUNITY_SBS_CHUNK_SIZE_BYTES:-1048576}"
volume_ids="${NAMROS_COMMUNITY_SBS_VOLUME_IDS:-}"

if [ -z "$volume_ids" ]; then
	volume_ids="${NAMROS_COMMUNITY_SBS_VOLUME_ID:-18a00001}"
fi

trim_value() {
	printf '%s' "$1" | tr -d ' \t\r\n'
}

endpoint_at() {
	list="$1"
	wanted_index="$2"
	fallback="$3"
	index=0
	selected=""
	old_ifs="$IFS"
	IFS=,
	for raw_endpoint in $list; do
		IFS="$old_ifs"
		endpoint="$(trim_value "$raw_endpoint")"
		if [ -n "$endpoint" ]; then
			if [ "$index" -eq "$wanted_index" ]; then
				selected="$endpoint"
				break
			fi
			index=$((index + 1))
		fi
		IFS=,
	done
	IFS="$old_ifs"
	if [ -z "$selected" ]; then
		selected="$fallback"
	fi
	printf '%s' "$selected"
}

set -- namros-admin volume-pool-put \
	-metadata-backend "$metadata_backend" \
	-tikv-pd-endpoints "$tikv_pd_endpoints" \
	-pool-id "$pool_id" \
	-generation "$generation" \
	-durability-class replicated \
	-storage-class STANDARD

member_count=0
old_ifs="$IFS"
IFS=,
for raw_volume_id in $volume_ids; do
	IFS="$old_ifs"
	volume_id="$(trim_value "$raw_volume_id")"
	if [ -z "$volume_id" ]; then
		IFS=,
		continue
	fi
	member_data_endpoint="$(endpoint_at "$data_endpoints" "$member_count" "$data_endpoint")"
	member="volume_id=$volume_id,service_endpoint=$service_endpoint,data_endpoint=$member_data_endpoint,generation=$generation,chunk_size_bytes=$chunk_size_bytes,state=active,weight=1"
	set -- "$@" -member "$member"
	member_count=$((member_count + 1))
	IFS=,
done
IFS="$old_ifs"

if [ "$member_count" -eq 0 ]; then
	printf '[volume-pool-bootstrap] ERROR: no SBS volume ids configured\n' >&2
	exit 1
fi

log "register pool=$pool_id generation=$generation volumes=$volume_ids data_endpoints=$data_endpoints"
"$@" >/tmp/namros-volume-pool.json
log "metadata volume pool registered"
