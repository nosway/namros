COMPOSE_PROJECT_NAME=namros-community

# Local image names and tag used by the Makefile/Compose profile.
NAMROS_IMAGE_TAG=local
NAMROS_GATEWAY_IMAGE=namros-gateway
NAMROS_TOOLS_IMAGE=namros-tools

# NAMRBD source context used for transition SBS image builds. Keep the default
# aligned with the public go.mod module version; override locally for forks or
# private development checkouts.
NAMROS_NAMRBD_CONTEXT=https://github.com/nosway/namrbd.git#v0.1.0

# Host bind for the local profile gateway.
NAMROS_LOCAL_PORT=9000
NAMROS_REGION=us-east-1

# Community profile host bind and dependency images.
NAMROS_COMMUNITY_PORT=9001
NAMROS_ETCD_IMAGE=gcr.io/etcd-development/etcd:v3.6.8
NAMROS_PD_IMAGE=pingcap/pd:v8.5.7
NAMROS_TIKV_IMAGE=pingcap/tikv:v8.5.7
NAMROS_HAPROXY_IMAGE=haproxy:3.0-alpine

# NAMROS-built SBS transition images.  Later, point these variables at
# NAMRBD-published images and run the community profile without rebuilding SBS.
NAMROS_USE_NAMRBD_SBS_IMAGES=0
NAMROS_SBS_IMAGE_TAG=local
NAMROS_SBS_SERVICE_IMAGE=namros-sbs-service
NAMROS_SBS_DATA_IMAGE=namros-sbs-data
NAMROS_SBSCTL_IMAGE=namros-sbsctl

# Example NAMRBD-owned SBS image mode:
# NAMROS_USE_NAMRBD_SBS_IMAGES=1
# NAMROS_SBS_IMAGE_TAG=local
# NAMROS_SBS_SERVICE_IMAGE=ghcr.io/nosway/namrbd-sbs-service
# NAMROS_SBS_DATA_IMAGE=ghcr.io/nosway/namrbd-sbs-data
# NAMROS_SBSCTL_IMAGE=ghcr.io/nosway/namrbd-sbsctl

# Community SBS bootstrap defaults.
NAMROS_COMMUNITY_DEPLOYMENT_PROFILE=production
NAMROS_COMMUNITY_CLUSTER_ID=namros-community
NAMROS_COMMUNITY_SBS_CLUSTER_ID=namros-community-sbs
NAMROS_COMMUNITY_SBS_VOLUME_ID=18a00001
NAMROS_COMMUNITY_SBS_VOLUME_IDS=18a00001,18a00002
NAMROS_COMMUNITY_SBS_VOLUME_POOL_ID=object-pool
NAMROS_COMMUNITY_SBS_VOLUME_POOL_GENERATION=0
NAMROS_COMMUNITY_SBS_DATA_ENDPOINT=sbs-data-1:9444
NAMROS_COMMUNITY_SBS_DATA_ENDPOINTS=sbs-data-1:9444,sbs-data-2:9444
NAMROS_COMMUNITY_SBS_ATTACHMENT_ID=att-namros-community-object-pool
NAMROS_COMMUNITY_SBS_WRITER_GROUP_ID=namros-community-writers
NAMROS_COMMUNITY_SBS_VOLUME_EPOCH=1
NAMROS_COMMUNITY_SBS_VOLUME_SIZE=64M
NAMROS_COMMUNITY_SBS_BLOCK_SIZE=4K
NAMROS_COMMUNITY_SBS_ALLOCATION_CHUNK_SIZE=1M
NAMROS_COMMUNITY_SBS_ALLOCATION_PAGE_SIZE=4M
NAMROS_COMMUNITY_SBS_REPLICATION_FACTOR=2
NAMROS_COMMUNITY_SBS_CHUNK_SIZE_BYTES=1048576

# Lightweight gateway + SBS backend quickstart defaults.
NAMROS_SBS_QUICKSTART_PORT=9002
NAMROS_SBS_QUICKSTART_CLUSTER_ID=namros-sbs-quickstart
NAMROS_SBS_QUICKSTART_SBS_CLUSTER_ID=namros-sbs-quickstart-cluster
NAMROS_SBS_QUICKSTART_VOLUME_ID=18c00001
NAMROS_SBS_QUICKSTART_VOLUME_IDS=18c00001,18c00002
NAMROS_SBS_QUICKSTART_VOLUME_POOL_ID=quickstart-pool
NAMROS_SBS_QUICKSTART_VOLUME_POOL_GENERATION=0
NAMROS_SBS_QUICKSTART_ATTACHMENT_ID=att-namros-sbs-quickstart
NAMROS_SBS_QUICKSTART_WRITER_GROUP_ID=namros-sbs-quickstart-writers
NAMROS_SBS_QUICKSTART_VOLUME_EPOCH=1
NAMROS_SBS_QUICKSTART_VOLUME_SIZE=64M
NAMROS_SBS_QUICKSTART_BLOCK_SIZE=4K
NAMROS_SBS_QUICKSTART_ALLOCATION_CHUNK_SIZE=1M
NAMROS_SBS_QUICKSTART_ALLOCATION_PAGE_SIZE=4M
NAMROS_SBS_QUICKSTART_REPLICATION_FACTOR=2
NAMROS_SBS_QUICKSTART_CHUNK_SIZE_BYTES=1048576

# Development secret files.  scripts/container/ensure-local-files.sh creates
# these only when they are missing.  Do not commit real secret files.
NAMROS_ROOT_ACCESS_KEY_ID_FILE=./secrets/root-access-key-id
NAMROS_ROOT_SECRET_ACCESS_KEY_FILE=./secrets/root-secret-access-key
